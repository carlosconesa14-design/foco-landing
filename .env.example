# IDs de bloques de anuncios bonificados de AdMob.
# Si no se definen se usan los IDs de prueba de Google (seguros para desarrollar).
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_REWARDED_IOS=
# Pon "false" solo en el build que subas a las tiendas.
VITE_ADMOB_TESTING=true

# Liga Millonario (Supabase). Por defecto, el proyecto de producción del juego.
# La clave es pública (publishable): la seguridad está en la Edge Function y en RLS.
VITE_LEAGUE_URL=
VITE_LEAGUE_KEY=
